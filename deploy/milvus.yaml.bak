log:
  level: warn
  stdout: true
  grpc:
    level: error

# In standalone mode all internal coordinators default to port 19530.
# They race to bind it → panic. Assign unique ports to each coordinator.
dataCoord:
  port: 13333

queryCoord:
  port: 19531

indexCoord:
  port: 31000

rootCoord:
  port: 53100

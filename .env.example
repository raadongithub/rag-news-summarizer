# Required
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required for chat/retrieval
VOYAGE_API_KEY=your-voyage-api-key

# App metadata and model behavior
APP_NAME=News Summarizer API
APP_VERSION=1.0.0
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
SUMMARY_GENERATION_TEMPERATURE=0.0
ARTICLE_SUMMARY_TEMPERATURE=0.7
CRITIQUE_TEMPERATURE=0.0

# Optional: shared runtime defaults
DEFAULT_TOP_K=3
DEFAULT_CHUNK_SIZE=3
DEFAULT_CHUNK_OVERLAP=1

# Database and auth
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/news_summarizer
ACCESS_TOKEN_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_TOKEN_ISSUER=news-summarizer
MIN_PASSWORD_LENGTH=8

# Optional: API configuration
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Milvus connection and indexing
MILVUS_URI=http://milvus-standalone:19530
MILVUS_COLLECTION_NAME=news_article_chunks
MILVUS_INDEX_TYPE=HNSW
MILVUS_INDEX_PARAMS={"M":16,"efConstruction":200}
MILVUS_SEARCH_PARAMS={"ef":64}

# Optional: retrieval behavior
RAG_TOP_K=3
RAG_CANDIDATE_MULTIPLIER=4
RAG_CONTEXTUAL_WINDOW=1
RAG_CONTEXTUAL_COMPRESSION_ENABLED=true
RAG_COMPRESSION_SIMILARITY_THRESHOLD=0.2
RAG_LLM_EXTRACTION_ENABLED=false

# Optional: embedding behavior
# VOYAGE_EMBEDDING_MODEL=voyage-4
# VOYAGE_EMBEDDING_DIMENSION=1024
